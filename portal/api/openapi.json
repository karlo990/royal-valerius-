 "components": {
  "schemas": {
   "ChatIn": {
    "properties": {
     "student_id": {
      "type": "string",
      "title": "Student Id"
     },
     "message": {
      "type": "string",
      "maxLength": 2000,
      "title": "Message"
     },
     "history": {
      "items": {
       "$ref": "#/components/schemas/ChatTurn"
      },
      "type": "array",
      "title": "History",
      "default": []
     },
     "client": {
      "type": "string",
      "enum": [
       "web",
       "app"
      ],
      "title": "Client",
      "default": "web"
     }
    },
    "type": "object",
    "required": [
     "student_id",
     "message"
    ],
    "title": "ChatIn"
   },
   "ChatTurn": {
    "properties": {
     "role": {
      "type": "string",
      "enum": [
       "user",
       "assistant"
      ],
      "title": "Role"
     },
     "content": {
      "type": "string",
      "title": "Content"
     }
    },
    "type": "object",
    "required": [
     "role",
     "content"
    ],
    "title": "ChatTurn"
   },
   "DeviceIn": {
    "properties": {
     "platform": {
      "type": "string",
      "enum": [
       "android",
       "ios",
       "web"
      ],
      "title": "Platform"
     },
     "push_token": {
      "type": "string",
      "maxLength": 4096,
      "title": "Push Token"
     },
     "student_ids": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Student Ids",
      "default": []
     }
    },
    "type": "object",
    "required": [
     "platform",
     "push_token"
    ],
    "title": "DeviceIn"
   },
   "FeedbackIn": {
    "properties": {
     "student_id": {
      "type": "string",
      "title": "Student Id"
     },
     "message": {
      "type": "string",
      "title": "Message"
     },
     "reply": {
      "type": "string",
      "title": "Reply"
     },
     "helpful": {
      "type": "boolean",
      "title": "Helpful"
     }
    },
    "type": "object",
    "required": [
     "student_id",
     "message",
     "reply",
     "helpful"
    ],
    "title": "FeedbackIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoginIn": {
    "properties": {
     "role": {
      "type": "string",
      "enum": [
       "learner",
       "parent"
      ],
      "title": "Role"
     },
     "identifier": {
      "type": "string",
      "title": "Identifier",
      "description": "Admission number (learner) or phone number (parent)"
     },
     "pin": {
      "type": "string",
      "title": "Pin"
     }
    },
    "type": "object",
    "required": [
     "role",
     "identifier",
     "pin"
    ],
    "title": "LoginIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  },
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer"
   }
  }
 },
 "servers": [
  {
   "url": "https://api.royalcrestacademy.com",
   "description": "Production (planned)"
  },
  {
   "url": "http://127.0.0.1:8000",
   "description": "Reference server"
  }
 ]
}